{
  "name": "parkpilot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ParkPilot - find parking, pay with NIM through Nimiq Pay.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:secrets": "node scripts/check-secrets.ts",
    "payout:send": "node --env-file-if-exists=.env scripts/send-payout.ts",
    "verify": "npm run check:secrets && npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@nimiq/mini-app-sdk": "^0.1.0",
    "@supabase/supabase-js": "^2.45.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.460.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0",
    "tailwind-merge": "^2.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nimiq/core": "^2.21.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/google.maps": "^3.66.2",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.1"
  }
}
