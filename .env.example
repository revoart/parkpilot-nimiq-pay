# ---------------------------------------------------------------------------
# ParkPilot environment variables (frontend / Vite).
# Copy to `.env` and fill in. Only VITE_* values are exposed to the browser.
# NEVER put the Supabase service-role key here.
# ---------------------------------------------------------------------------

# Supabase (frontend uses URL + anon/publishable key only)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Nimiq block explorer, used for transaction links. Payments are NIM on the
# Nimiq chain — the native coin, so there is no token contract and no gas
# token to configure.
VITE_NIMIQ_EXPLORER_URL=https://nimiq.watch

# Google Maps browser key. This is a PUBLIC browser key (it ships in the
# client bundle), so protect it with an HTTP-referrer restriction in Google
# Cloud (e.g. https://your-app.vercel.app/*). If it is empty the map area
# degrades to a static placeholder.
#
# The same key powers in-app routing (Routes API `computeRoutes`), which needs
# the "Routes API" enabled on the project. If it is unavailable the app falls
# back to the legacy Directions service, then to a labelled straight-line
# estimate.
VITE_GOOGLE_MAPS_API_KEY=
# Optional Google Maps "channel" parameter for usage reporting.
VITE_GOOGLE_MAPS_TRACKING_ID=
# Optional cloud-styled Map ID. Setting one switches the map to vector
# rendering, which enables camera rotation during navigation and moves styling
# into Google Cloud (inline styles are then ignored).
VITE_GOOGLE_MAPS_MAP_ID=
# Exposes window.__PARKPILOT_MAP__ / __PARKPILOT_ROTATION__ for diagnosing map
# rotation and vector rendering. Local development only — never enable in
# production.
VITE_DEBUG_MAP=

# App mode: "production" (real payments) or "development" (clearly-labelled
# dev helpers). Development mode MUST be off for the hackathon submission.
VITE_APP_MODE=production
